{
  "name": "AWS CDK & Python Development Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "containerEnv": {
    "AWS_CONFIG_FILE": "${containerWorkspaceFolder}/.aws/config"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "22.6.0"
    },
    "ghcr.io/devcontainers/features/python:1.8.0": {
      "version": "3.12.0"
    },
    "ghcr.io/devcontainers/features/aws-cli:1.1.4": {},
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },
  "postCreateCommand": "mkdir -p \"${containerWorkspaceFolder}/.claude-user\" && rm -rf \"$HOME/.claude\" && ln -sfn \"${containerWorkspaceFolder}/.claude-user\" \"$HOME/.claude\" && ./tools/setup.sh",
  "shutdownAction": "stopContainer"
}
